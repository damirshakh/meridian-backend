# Bazaga ulanish (Railway/Render bersa shu yerga qo'yiladi)
DATABASE_URL=postgresql://user:password@localhost:5432/meridian

# JWT sirlari — PRODUCTIONDA albatta uzun, tasodifiy qiymatga almashtiring!
# Generatsiya qilish uchun: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=o'zgartiring_kamida_64_random_belgi
JWT_REFRESH_SECRET=buni_ham_o'zgartiring_boshqa_qiymat_bilan

# Portlar / muhit
PORT=4000
NODE_ENV=development

# CORS uchun ruxsat etilgan frontend manzillari (vergul bilan ajratilgan)
CORS_ORIGINS=http://localhost:5173,http://localhost:19006,http://localhost:8081

# MUHIM: Yuklangan rasmlar (mahsulot rasmlari, bannerlar) shu manzil orqali ochiladi.
# - Agar bo'sh qoldirsangiz, so'rov qaysi manzildan kelgan bo'lsa o'shani ishlatadi (masalan localhost) —
#   BU TELEFON YOKI BOSHQA QURILMADA RASM KO'RINMASLIGIGA OLIB KELADI.
# - Kompyuteringizda test qilayotganda: kompyuteringizning lokal tarmoq IP manzilini yozing
#   (Windows'da "ipconfig" buyrug'i bilan "IPv4 Address" qatorini toping, masalan 192.168.1.5)
# - Productionda (serverga joylashtirilgach): https://sizning-domeningiz.com
PUBLIC_BASE_URL=http://192.168.1.5:4000
